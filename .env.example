NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Neon pooled endpoint for API runtime (host includes -pooler).
DATABASE_URL=postgresql://esekone_app:replace-me@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon direct endpoint for schema migrations (host has no -pooler).
DATABASE_MIGRATION_URL=postgresql://esekone_migrator:replace-me@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_APP_ROLE=esekone_app
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=esekone-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AGENT_WORKER_TOKEN=replace-with-at-least-32-random-characters
