NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ESEKONE-owned PostgreSQL only. Never point these values at another product,
# a clinic database, or an imported customer backup.
ESEKONE_DATABASE_HOST=localhost
ESEKONE_DATABASE_NAME=esekone
DATABASE_URL=postgresql://esekone_app:replace-me@localhost:5432/esekone
DATABASE_MIGRATION_URL=postgresql://esekone_migrator:replace-me@localhost:5432/esekone

OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=esekone-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
